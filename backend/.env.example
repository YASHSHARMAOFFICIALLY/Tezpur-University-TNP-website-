DATABASE_URL=postgresql://tnp:tnp@localhost:5434/tnp
# Production only: password of the `db` service (docker compose builds the app's DATABASE_URL from it).
# Hex keeps it URL-safe: openssl rand -hex 24
POSTGRES_PASSWORD=
PORT=3000
# 32+ random chars each: openssl rand -hex 32. NODE_ENV=production refuses to start on "change-me".
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_SECRET=change-me-change-me-change-me-change-me
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./data/uploads
STUDENT_EMAIL_DOMAIN=tezu.ac.in
# First admin (TPO), created by `npm run seed`. Forced password change on first login.
SEED_ADMIN_EMAIL=tpo@tezu.ac.in
SEED_ADMIN_PASSWORD=change-me-now
# SMTP: university relay (preferred) or Gmail + app password. Unset SMTP_HOST = log mail to stdout (refused in production).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="T&P Cell <tnp@tezu.ac.in>"
# Gmail: SMTP_PER_DAY=450 SMTP_PER_MINUTE=20. Relay: leave empty (no limit).
SMTP_PER_DAY=
SMTP_PER_MINUTE=
